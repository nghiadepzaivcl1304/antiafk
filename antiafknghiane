-- Logic Bật / Tắt + Hiệu ứng đổi màu mượt (Tween)
local isEnabled = false

toggleButton.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    
    if isEnabled then
        toggleButton.Text = "TRẠNG THÁI: ON"
        -- Đổi Gradient sang màu Xanh
        buttonGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 255, 120)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 160, 60))
        })
        mainStroke.Color = Color3.fromRGB(50, 255, 100) -- Viền đổi sang xanh
    else
        toggleButton.Text = "TRẠNG THÁI: OFF"
        -- Đổi Gradient sang màu Đỏ
        buttonGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 20, 20))
        })
        mainStroke.Color = Color3.fromRGB(0, 170, 255) -- Viền trở lại xanh dương
    end
end)

-- Vòng lặp Anti-AFK
task.spawn(function()
    while true do
        task.wait(5)
        if isEnabled then
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChildOfClass("Humanoid") then
                    character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end)
            
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end
end)

-- Phương án dự phòng với Idled
LocalPlayer.Idled:Connect(function()
    if isEnabled then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end
end)

-- Phím K để Ẩn/Hiện
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
        mainFrame.Visible = not mainFrame.Visible
    end
end)
